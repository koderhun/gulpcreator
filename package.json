{
  "name": "gulpstarter",
  "type": "module",
  "description": "Frontend start kit",
  "author": "another",
  "license": "MIT",
  "scripts": {
    "dev": "gulp",
    "build": "gulp prod --production",
    "build:views": "gulp views --production",
    "build:styles": "gulp styles --production",
    "build:scripts": "gulp scripts --production",
    "build:images": "gulp images --production",
    "build:webp": "gulp webp --production",
    "build:sprites": "gulp sprites --production",
    "build:fonts": "gulp fonts --production",
    "build:favicons": "gulp favicons --production",
    "build:gzip": "gulp gzip --production",
    "lint:styles": "stylelint \"src/**/*.scss\" --syntax=scss",
    "lint:styles --fix": "stylelint \"src/**/*.scss\" --syntax=scss --fix",
    "lint:scripts": "eslint --color ./src/blocks",
    "lint:scripts --fix": "eslint --fix --color ./src/blocks",
    "deploy": "gulp prod --production && gulp gzip --production && gulp deploy"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "del": "^8.0.1",
    "gulp": "^5.0.1",
    "gulp-babel": "^8.1.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-debug": "^5.0.1",
    "gulp-favicons": "^4.0.2",
    "gulp-file-include": "^2.3.0",
    "gulp-gh-pages": "^0.5.4",
    "gulp-htmlmin": "^5.0.1",
    "gulp-if": "^3.0.0",
    "gulp-image": "^6.3.1",
    "gulp-newer": "^1.4.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-real-favicon": "^0.3.2",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-watch": "^5.0.1",
    "gulp-webp": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "require-dir": "^1.2.0",
    "sass": "^1.103.0",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.109.2",
    "webpack-stream": "^7.0.0",
    "yargs": "^18.1.0"
  },
  "dependencies": {
    "jquery": "^4.0.0",
    "swiper": "^14.0.1"
  },
  "lint-staged": {
    "!(_*).scss": [
      "stylelint --fix --color --config ./.stylelintrc"
    ],
    "*.js": [
      "eslint --fix --color"
    ]
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "IE 10"
  ]
}
